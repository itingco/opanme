APP_NAME="Stock Opname"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stock_opname
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_DRIVER=database
QUEUE_CONNECTION=database

ERP_HOST=127.0.0.1
ERP_PORT=1433
ERP_USERNAME=
ERP_PASSWORD=
ERP_INGCO_DATABASE=AS_INGCO
ERP_SMI_DATABASE=AS_SMI
ERP_ENCRYPT=yes
ERP_TRUST_SERVER_CERTIFICATE=true

# Shared Barcode/Ratio master on the same SQL Server.
APPHUB_HOST=${ERP_HOST}
APPHUB_PORT=${ERP_PORT}
APPHUB_DATABASE=DB_AppHub
APPHUB_USERNAME=${ERP_USERNAME}
APPHUB_PASSWORD=${ERP_PASSWORD}
APPHUB_ENCRYPT=${ERP_ENCRYPT}
APPHUB_TRUST_SERVER_CERTIFICATE=${ERP_TRUST_SERVER_CERTIFICATE}

# Set true only after `php artisan app:check-databases` confirms DB_AppHub.
# This drops the obsolete PostgreSQL local master tables during migration.
APPHUB_DROP_LOCAL_MASTERS=false
